# RevMan Environment Configuration
# Copy this file to .env and update with your values

# Anthropic API Key (required)
# Get your API key from: https://console.anthropic.com/settings/keys
# IMPORTANT: Do NOT use quotes around the API key value
# Correct:   ANTHROPIC_API_KEY=sk-ant-api03-...
# Wrong:     ANTHROPIC_API_KEY="sk-ant-api03-..."
ANTHROPIC_API_KEY=sk-ant-api03-your-actual-api-key-here

# Email Recipients (comma-separated list)
# Used in metadata output for email recipients
REVMAN_EMAIL_RECIPIENTS=aaditya.singhal@anheuser-busch.com

# Optional: Override data directory paths
# REVMAN_DATA_DIR=./data
# REVMAN_INPUT_DIR=./data/input
# REVMAN_OUTPUT_DIR=./data/output
# REVMAN_TEMPLATE_DIR=./data/templates
